DATABASE_URL="postgresql://user:password@localhost:5432/fitstack"

# ─── Authentication (Clerk) ─────────────────────────────────────
# Get from: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─── AI Provider (Google Gemini) ────────────────────────────────
# Get from: https://aistudio.google.com/
# Used in Phase 17 (AI Coach) — add now so env structure is ready
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative AI providers (uncomment the one you use)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── File Storage (Cloudinary) ──────────────────────────────────
# Get from: https://cloudinary.com/
# Used in Phase 13+ (progress photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Payments (Stripe) ──────────────────────────────────────────
# Get from: https://dashboard.stripe.com/
# Used in Phase 18 (Subscriptions)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (configure your products in Stripe dashboard)
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxx
STRIPE_ELITE_MONTHLY_PRICE_ID=price_xxx

# ─── Application ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
