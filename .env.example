# Copy to .env.local (Next.js) — and .env for Prisma CLI commands — then fill in.
# Never commit real values.

# ─── Database (PostgreSQL, e.g. Supabase / Neon) ────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/fitstack"

# ─── Auth (Clerk) — https://dashboard.clerk.com ─────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ─── AI (Google Gemini) — https://aistudio.google.com ───────────
GEMINI_API_KEY=xxx
# Optional: override the model (default: gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-lite-latest

# ─── Payments (Razorpay) — https://dashboard.razorpay.com ───────
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
# Webhook: POST https://<your-domain>/api/webhooks/razorpay
# Events: order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=xxx

# ─── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Free key from https://cloud.maptiler.com — dark street map behind run routes (optional; routes draw without it)
NEXT_PUBLIC_MAPTILER_KEY=
